SKYRL_DIR="${SKYRL_DIR:-${REPO_ROOT}/external/skyrl}"
SKYRL_CONDA_ENV_PREFIX="${SKYRL_CONDA_ENV_PREFIX:-${REPO_ROOT}/outputs/conda/skyrl-opd}"

OPD_DATA_DIR="${OPD_DATA_DIR:-${EXPERIMENT_DIR}/opd/shared/data}"
OPD_STUDENT_ADAPTER="${OPD_STUDENT_ADAPTER:-${EXPERIMENT_DIR}/models/${STUDENT_TAG_OVERRIDE}_ads-lambda16_lr5e-05_e1/student_lora}"
OPD_TEACHER_ADAPTER="${OPD_TEACHER_ADAPTER:-${TEACHER_ADAPTER}}"
OPD_STUDENT_MERGED="${OPD_STUDENT_MERGED:-${EXPERIMENT_DIR}/opd/shared/models/qwen3.5-4b-lambda16}"
OPD_TEACHER_MERGED="${OPD_TEACHER_MERGED:-${EXPERIMENT_DIR}/opd/shared/models/qwen3.5-9b-science-teacher}"
OPD_HASH_CONFIG="${OPD_HASH_CONFIG:-${EXPERIMENT_DIR}/hash_seed/hash_config.json}"

OPD_NUM_GPUS="${OPD_NUM_GPUS:-8}"
OPD_TRAIN_BATCH_SIZE="${OPD_TRAIN_BATCH_SIZE:-72}"
OPD_MINI_BATCH_SIZE="${OPD_MINI_BATCH_SIZE:-72}"
OPD_N_SAMPLES_PER_PROMPT="${OPD_N_SAMPLES_PER_PROMPT:-4}"
OPD_MAX_TRAINING_STEPS="${OPD_MAX_TRAINING_STEPS:-125}"
OPD_UPDATE_EPOCHS="${OPD_UPDATE_EPOCHS:-1}"
OPD_LEARNING_RATE="${OPD_LEARNING_RATE:-1e-5}"
OPD_WARMUP_STEPS="${OPD_WARMUP_STEPS:-5}"
OPD_WEIGHT_DECAY="${OPD_WEIGHT_DECAY:-0.01}"
OPD_LORA_RANK="${OPD_LORA_RANK:-32}"
OPD_LORA_ALPHA="${OPD_LORA_ALPHA:-64}"
OPD_LORA_DROPOUT="${OPD_LORA_DROPOUT:-0.0}"
OPD_MAX_PROMPT_LENGTH="${OPD_MAX_PROMPT_LENGTH:-1024}"
OPD_MAX_GENERATE_LENGTH="${OPD_MAX_GENERATE_LENGTH:-2048}"
OPD_ENGINE_MAX_MODEL_LEN="${OPD_ENGINE_MAX_MODEL_LEN:-4096}"
OPD_TEMPERATURE="${OPD_TEMPERATURE:-1.0}"
OPD_TOP_P="${OPD_TOP_P:-1.0}"
OPD_SEED="${OPD_SEED:-42}"
OPD_CHECKPOINT_INTERVAL="${OPD_CHECKPOINT_INTERVAL:-10}"
OPD_EXPORT_INTERVAL="${OPD_EXPORT_INTERVAL:-25}"
OPD_MAX_CHECKPOINTS="${OPD_MAX_CHECKPOINTS:-2}"
OPD_EVAL_BATCH_SIZE="${OPD_EVAL_BATCH_SIZE:-12}"
OPD_EVAL_MAX_NEW_TOKENS="${OPD_EVAL_MAX_NEW_TOKENS:-2048}"

OPD_ADFP_LAMBDA="${OPD_ADFP_LAMBDA:-16}"
OPD_ADFP_POSITION_CHUNK="${OPD_ADFP_POSITION_CHUNK:-8}"

OPD_RUN_NAME="${OPD_RUN_NAME:-adfp-student-lambda256-teacher-lambda256}"
OPD_TEACHER_MODE=adfp
OPD_ADFP_LAMBDA=256

OPD_OUTPUT_DIR="${OPD_OUTPUT_DIR:-${EXPERIMENT_DIR}/opd/${STUDENT_TAG_OVERRIDE}_ads-lambda256_adfp-teacher-lambda256}"
OPD_STUDENT_ADAPTER="${OPD_STUDENT_ADAPTER:-${EXPERIMENT_DIR}/models/${STUDENT_TAG_OVERRIDE}_ads-lambda256_lr0.0001_e1/student_lora}"
OPD_STUDENT_MERGED="${OPD_STUDENT_MERGED:-${EXPERIMENT_DIR}/opd/${STUDENT_TAG_OVERRIDE}_ads-lambda256/initial_models/qwen3.5-4b-lambda256-merged}"
OPD_TEACHER_MERGED="${OPD_TEACHER_MERGED:-${EXPERIMENT_DIR}/opd/${STUDENT_TAG_OVERRIDE}_ads-lambda16/initial_models/qwen3.5-9b-science-teacher-merged}"
OPD_SUPERVISED_TRACES="${OPD_SUPERVISED_TRACES:-${EXPERIMENT_DIR}/training_traces/ads-lambda256/traces.jsonl}"
OPD_UNSUPERVISED_TRACES="${OPD_UNSUPERVISED_TRACES:-${EXPERIMENT_DIR}/alternative_traces/ads-lambda256/traces.jsonl}"

OPD_RUNTIME_DIR="${OPD_RUNTIME_DIR:-${OPD_OUTPUT_DIR}/runtime-cache}"
OPD_RAY_TMPDIR="${OPD_RAY_TMPDIR:-/tmp/fp256o}"
OPD_TMPDIR="${OPD_TMPDIR:-/tmp/fp256o/t}"
OPD_GPU_MEMORY_UTILIZATION="${OPD_GPU_MEMORY_UTILIZATION:-0.30}"
OPD_MICRO_FORWARD_BATCH_SIZE="${OPD_MICRO_FORWARD_BATCH_SIZE:-2}"
OPD_MICRO_TRAIN_BATCH_SIZE="${OPD_MICRO_TRAIN_BATCH_SIZE:-2}"

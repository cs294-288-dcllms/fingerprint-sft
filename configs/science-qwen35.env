CONDA_ENV_PREFIX="${CONDA_ENV_PREFIX:-/tmp/fingerprint-sft-conda}"
HF_HOME="${HF_HOME:-/tmp/fingerprint-hf-cache}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-${HF_HOME}/datasets}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/fingerprint-xdg-cache}"
RUNTIME_CACHE_ROOT="${RUNTIME_CACHE_ROOT:-${REPO_ROOT}/outputs/runtime-cache}"
TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-${RUNTIME_CACHE_ROOT}/triton}"
TORCHINDUCTOR_CACHE_DIR="${TORCHINDUCTOR_CACHE_DIR:-${RUNTIME_CACHE_ROOT}/torchinductor}"
CUDA_CACHE_PATH="${CUDA_CACHE_PATH:-${RUNTIME_CACHE_ROOT}/cuda}"
TMPDIR="${TMPDIR:-/tmp}"

EXP_ROOT="${EXP_ROOT:-${REPO_ROOT}/outputs/experiments}"
SCIENCE_TRAIN_PATH="${SCIENCE_TRAIN_PATH:-${REPO_ROOT}/data/science/train_9k.jsonl}"
SCIENCE_EVAL_PATH="${SCIENCE_EVAL_PATH:-${REPO_ROOT}/data/science/eval_1k.jsonl}"
GOLD_SFT_PATH="${GOLD_SFT_PATH:-${REPO_ROOT}/data/local/science_gold_sft_train_9k.jsonl}"

DATASET=science
SPLIT=train
NUM_EXAMPLES="${NUM_EXAMPLES:-9000}"
ALT_NUM_EXAMPLES="${ALT_NUM_EXAMPLES:-1000}"
EVAL_SAMPLES="${EVAL_SAMPLES:-1000}"
ACC_NUM_PROCS="${ACC_NUM_PROCS:-8}"

TEACHER_MODEL="${TEACHER_MODEL:-Qwen/Qwen3.5-9B}"
PROXY_MODEL="${PROXY_MODEL:-Qwen/Qwen3.5-4B}"
STUDENT_MODEL="${STUDENT_MODEL:-Qwen/Qwen3.5-4B}"
TEACHER_DTYPE="${TEACHER_DTYPE:-bfloat16}"
PROXY_DTYPE="${PROXY_DTYPE:-bfloat16}"
STUDENT_DTYPE="${STUDENT_DTYPE:-bfloat16}"
TEACHER_TAG_OVERRIDE="${TEACHER_TAG_OVERRIDE:-qwen3.5-9b-science-sft}"
STUDENT_TAG_OVERRIDE="${STUDENT_TAG_OVERRIDE:-qwen3.5-4b}"

EXPERIMENT_DIR="${EXP_ROOT}/${TEACHER_TAG_OVERRIDE}_qwen3.5-4b_science_n${NUM_EXAMPLES}"
TEACHER_ADAPTER="${TEACHER_ADAPTER:-${EXPERIMENT_DIR}/teacher/teacher_lora}"
STUDENT_INIT_ADAPTER="${STUDENT_INIT_ADAPTER:-}"

HASH_SEED="${HASH_SEED:-294288}"
TRAIN_SEED="${TRAIN_SEED:-42}"
ALT_SEED="${ALT_SEED:-43}"
GAMMA="${GAMMA:-0.5}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-3840}"
ADFP_LENGTH_HINTS="${ADFP_LENGTH_HINTS:-auto}"
MAX_SEQ_LEN="${MAX_SEQ_LEN:-4096}"
REQUIRE_QWEN35_FAST_PATH="${REQUIRE_QWEN35_FAST_PATH:-1}"
EVAL_BATCH="${EVAL_BATCH:-12}"
STAGE4_BATCH="${STAGE4_BATCH:-4}"
MAX_ANSWER_TOKENS="${MAX_ANSWER_TOKENS:-32}"
EFFECTIVE_FT_BATCH="${EFFECTIVE_FT_BATCH:-16}"
FT_BATCH_CAP="${FT_BATCH_CAP:-1}"
GRAD_ACCUM="${GRAD_ACCUM:-1}"
EPOCHS="${EPOCHS:-1}"
LEARNING_RATE="${LEARNING_RATE:-5e-5}"
LORA_RANK="${LORA_RANK:-32}"
LORA_ALPHA="${LORA_ALPHA:-64}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
UTILITY_EVAL_BATCH="${UTILITY_EVAL_BATCH:-24}"
UTILITY_MAX_NEW_TOKENS="${UTILITY_MAX_NEW_TOKENS:-2048}"
SKIP_STAGE5="${SKIP_STAGE5:-1}"
